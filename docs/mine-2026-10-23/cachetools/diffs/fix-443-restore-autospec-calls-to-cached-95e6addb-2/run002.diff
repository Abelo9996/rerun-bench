+    def __call__(self, *args, **kwargs):
+        # The receiver is not part of __call__'s signature, so that autospec
+        # mocks accept calls without it.
+        if not args:
+            raise TypeError(f"{self.__qualname__}() missing 1 required argument")
+        obj, *args = args
