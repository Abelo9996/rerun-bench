--- /dev/null
+++ b/tests/test_duration.py
@@ -0,0 +1,70 @@
+import unittest
+
+from duration import parse_duration
+
+
+class ParseDurationTests(unittest.TestCase):
+    def test_parses_each_unit(self):
+        cases = {
+            "1h": 3600,
+            "2m": 120,
+            "45s": 45,
+        }
+        for text, expected in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), expected)
+
+    def test_parses_combined_units_in_order(self):
+        cases = {
+            "1h30m": 5400,
+            "2h5s": 7205,
+            "3m4s": 184,
+            "1h2m3s": 3723,
+        }
+        for text, expected in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), expected)
+
+    def test_accepts_zero_and_large_components(self):
+        cases = {
+            "0s": 0,
+            "0h0m0s": 0,
+            "25h": 90000,
+            "90m": 5400,
+            "120s": 120,
+        }
+        for text, expected in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), expected)
+
+    def test_ignores_surrounding_whitespace(self):
+        self.assertEqual(parse_duration("  \t1h2m3s\n "), 3723)
+
+    def test_rejects_empty_or_whitespace_only_input(self):
+        for text in ("", " ", "\t\n"):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_malformed_or_out_of_order_components(self):
+        invalid = (
+            "1d",
+            "1h2h",
+            "1m2h",
+            "1s2m",
+            "1h2s3m",
+            "h",
+            "1",
+            "1.5s",
+            "-1s",
+            "1h 2m",
+            "1h2m trailing",
+        )
+        for text in invalid:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
