+def is_palindrome(text):
+    """Return whether ``text`` reads the same forwards and backwards.
+
+    Case and characters other than letters and digits are ignored.
+    """
+    normalized = [character.casefold() for character in text if character.isalnum()]
+    return normalized == normalized[::-1]
 
 
